# Token Plan API Key。不要提交真实值。
MINIMAX_API_KEY=replace-with-your-token-plan-key

# 中国大陆：https://api.minimaxi.com
# 海外：https://api.minimax.io
MINIMAX_API_HOST=https://api.minimaxi.com

# 默认仅本机访问。仅在可信内网或有鉴权的反向代理后改为 0.0.0.0。
MINIMAX_MCP_BIND_ADDRESS=127.0.0.1
MINIMAX_MCP_PORT=18080

FASTMCP_LOG_LEVEL=WARNING
MCP_LOG_LEVEL=info
