# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
# 1. 选后端链 (逗号分隔, 按顺序 fallback)
YUXI_SEARCH_BACKEND=duckduckgo,tavily
# 2. 多 Tavily key 池 (注册 N 个免费账号, 轮询 + 熔断)
TAVILY_API_KEYS=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,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
# 3. 可选: key 熔断冷却秒数 (默认 60)
YUXI_SEARCH_KEY_COOLDOWN=6000

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# OIDC 单点登录（默认关闭；每个环境须向认证中心申请独立 Confidential Client）
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=统一认证
# 主配置：认证中心 Issuer 根地址。服务端从 {issuer}/.well-known/openid-configuration 读取端点。
OIDC_ISSUER_BASE_URL=
# 兼容旧配置名：仅在未设置 OIDC_ISSUER_BASE_URL 时读取；不要同时设置。
# OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ID Token 仅接受这里明确允许的算法；默认统一认证使用 RS256。
OIDC_ID_TOKEN_ALGORITHMS=RS256
# 必须是认证中心已登记且逐字符一致的完整 HTTPS 地址。
# OIDC_REDIRECT_URI=https://your-yuxi-host.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
# 仅升级旧版 issuer-less OIDC 绑定时临时配置为原认证中心 Issuer；新部署保持为空。
# OIDC_LEGACY_ISSUER_URL=https://old-issuer.example.com

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

